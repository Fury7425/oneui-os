# OneUI OS: Fedora Kinoite (KDE Plasma, atomic) with a One UI look and Galaxy Book hardware support.
# Bump the tag (44 -> 45) once Fedora 45 is out; everything else follows the base image.
ARG BASE=ghcr.io/ublue-os/kinoite-main:44

FROM scratch AS ctx
COPY build_files /
COPY system_files /system_files

# Throwaway stage: compiles the Galaxy Book speaker driver so gcc/kernel-devel never reach the image.
FROM ${BASE} AS kmod
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=secret,id=mok_key \
    bash /ctx/kmod.sh

FROM ${BASE}
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=bind,from=kmod,source=/out,target=/kmod \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    bash /ctx/build.sh

RUN bootc container lint
