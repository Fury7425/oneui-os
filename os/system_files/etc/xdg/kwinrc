# three workspaces, like the mockup's left pill
[Desktops]
Number=3
Rows=1

[Plugins]
blurEnabled=true
# popups animate with the guide's curves (oneuios_popups), so the stock popup effects stay off
oneuios_popupsEnabled=true
slidingpopupsEnabled=false
fadingpopupsEnabled=false

[Effect-blur]
BlurStrength=12

[org.kde.kdecoration2]
library=org.kde.breeze
ButtonsOnLeft=
ButtonsOnRight=IAX
